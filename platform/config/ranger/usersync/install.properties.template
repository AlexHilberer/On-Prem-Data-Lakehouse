POLICY_MGR_URL=http://ranger-admin:6080
SYNC_SOURCE=ldap
MIN_UNIX_USER_ID_TO_SYNC=1000
SYNC_INTERVAL=1
unix_user=ranger
unix_group=ranger
rangerUsersync_password=${RANGER_ADMIN_PASSWORD}
SYNC_LDAP_URL=ldaps://openldap:636
SYNC_LDAP_BIND_DN=cn=admin,dc=lakehouse,dc=local
SYNC_LDAP_BIND_PASSWORD=${LDAP_ADMIN_PASSWORD}
SYNC_LDAP_SEARCH_BASE=dc=lakehouse,dc=local
SYNC_LDAP_USER_SEARCH_BASE=ou=people,dc=lakehouse,dc=local
SYNC_LDAP_USER_SEARCH_SCOPE=sub
SYNC_LDAP_USER_OBJECT_CLASS=inetOrgPerson
SYNC_LDAP_USER_SEARCH_FILTER=(objectClass=inetOrgPerson)
SYNC_LDAP_USER_NAME_ATTRIBUTE=uid
SYNC_LDAP_USER_GROUP_NAME_ATTRIBUTE=memberOf
SYNC_GROUP_SEARCH_ENABLED=true
SYNC_GROUP_USER_MAP_SYNC_ENABLED=true
SYNC_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=lakehouse,dc=local
SYNC_LDAP_GROUP_SEARCH_SCOPE=sub
SYNC_LDAP_GROUP_OBJECT_CLASS=groupOfNames
SYNC_LDAP_GROUP_SEARCH_FILTER=(objectClass=groupOfNames)
SYNC_LDAP_GROUP_NAME_ATTRIBUTE=cn
SYNC_LDAP_GROUP_MEMBER_ATTRIBUTE_NAME=member
SYNC_LDAP_REFERRAL=ignore

