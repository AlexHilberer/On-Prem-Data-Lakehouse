PYTHON_COMMAND_INVOKER=python3
DB_FLAVOR=POSTGRES
SQL_CONNECTOR_JAR=/usr/share/java/postgresql.jar
db_root_user=platform_admin
db_root_password=${POSTGRES_ADMIN_PASSWORD}
db_host=${RANGER_DB_HOST}
db_name=${RANGER_DB_NAME}
db_user=${RANGER_DB_USER}
db_password=${RANGER_DB_PASSWORD}
audit_store=log4j
policymgr_external_url=http://ranger-admin:6080
policymgr_http_enabled=true
rangerAdmin_password=${RANGER_ADMIN_PASSWORD}
rangerTagsync_password=${RANGER_ADMIN_PASSWORD}
rangerUsersync_password=${RANGER_ADMIN_PASSWORD}
keyadmin_password=${RANGER_ADMIN_PASSWORD}
unix_user=ranger
unix_user_pwd=ranger
unix_group=ranger
authentication_method=LDAP
xa_ldap_url=ldaps://openldap:636
xa_ldap_userDNpattern=uid={0},ou=people,dc=lakehouse,dc=local
xa_ldap_groupSearchBase=ou=groups,dc=lakehouse,dc=local
xa_ldap_groupSearchFilter=(member=uid={0},ou=people,dc=lakehouse,dc=local)
xa_ldap_referral=ignore

